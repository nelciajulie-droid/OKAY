DATABASE_URL=file:/home/z/my-project/db/custom.db

# Vault Worker (Cloudflare KV) — stores ChatGPT JWT, Perplexity cookies, Google cookies, Inworld token.
# The vault URL is the deployed Worker; the secret is the X-Vault-Secret header value
# (matches the Chrome extension's DEFAULT_VAULT_SECRET).
CHATGPT_VAULT_URL=https://chatgpt-jwt-vault.nelciajulie.workers.dev
CHATGPT_VAULT_SECRET=vault-1790821129-8408ba08218ff55d

# Gemini Live (Google AI Studio) — the X-Goog-Api-Key header value.
# This is the public AI Studio API key (from aistudio.google.com/app/apikey).
GEMINI_API_KEY=AIzaSyDdP816MREB3SkjZO04QXbjsigfcI0GWOs

# Perplexity proxy list — Vietnam proxies that bypass Cloudflare.
# Free proxies from proxyscrape.com + github.com/monosans/proxy-list.
# The route tries them in parallel (5 at a time) and uses the first that works.
PERPLEXITY_PROXY_LIST=socks4://171.249.163.170:1080,socks5://217.76.39.4:1080,http://171.232.79.28:8080

# Perplexity relay proxy — Cloudflare Tunnel URL on the user's machine.
# Set this to the trycloudflare URL (e.g. https://xxx.trycloudflare.com)
PERPLEXITY_RELAY_URL=https://metropolitan-workforce-king-operation.trycloudflare.com
