# NyxProxy deployment bundle — Boppy Studio IPv6 rotation proxy
# EDIT THESE TWO LINES, then run ./deploy.sh on your VPS.
PROXY_USERNAME: admin
PROXY_PASSWORD: CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Your /64 IPv6 subnet, e.g. 2a05:f480:1800:25db::/64 (auto-detected by deploy.sh if empty)
IPV6_SUBNET: ""

# Interface name (auto-detected by deploy.sh if empty, e.g. enp1s0 / eth0)
INTERFACE_NAME: ""

# Rotation settings (defaults are the "Moderate (Recommended)" profile)
POOL_SIZE: 200
MAX_USAGE: 100
MAX_AGE_MIN: 30

# Listening port (8080 = HTTPS proxy)
LISTEN_PORT: 8080

# Monitoring port (localhost only by default)
MONITORING_PORT: 9090
